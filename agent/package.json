{
  "name": "ulab-agent",
  "version": "3.10.2",
  "description": "ULAB Local Agent for the Desktop application",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:exe": "pkg dist/index.js --targets node18-win-x64 --output dist/ulab-agent.exe",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "npx tsx ./test/mcp.test.ts && npx tsx ./test/git.test.ts && npx tsx ./test/security.test.ts && npx tsx ./test/e2e.test.ts"
  },
  "keywords": [
    "ai",
    "local",
    "bridge",
    "agent",
    "workspace"
  ],
  "author": "ULAB Team",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "pkg": "^5.8.1",
    "typescript": "^5.3.3"
  }
}
