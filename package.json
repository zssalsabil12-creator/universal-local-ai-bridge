{
  "name": "sandbox-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "npm run sync:download && vite build",
    "sync:download": "node scripts/sync-release-download.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:security": "npx tsx ./agent/test/security.test.ts",
    "test:e2e": "npx tsx ./agent/test/e2e.test.ts",
    "test:phase2": "npx tsx ./agent/test/phase2-comm.test.ts",
    "test:secrets": "node ./scan-secrets.js release",
    "test": "npx tsx ./agent/test/security.test.ts && npx tsx ./agent/test/e2e.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.98.0",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^2.30.0",
    "framer-motion": "^11.16.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.10.0",
    "uuid": "^11.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/canvas-confetti": "^1.6.4",
    "@types/jszip": "^3.4.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  }
}
